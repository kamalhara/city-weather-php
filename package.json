{
  "name": "weatherly-php-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build tools for the Weatherly PHP dashboard",
  "scripts": {
    "css:build": "npx @tailwindcss/cli -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css",
    "css:watch": "npx @tailwindcss/cli -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3"
  }
}
